---
interface Props {
  name: string;
  alt: string;
  width?: number;
  height?: number;
  hero?: boolean;
  sizes?: string;
}
const { name, alt, width = 1600, height = 1600, hero = false, sizes = '(max-width: 700px) calc(100vw - 48px), (max-width: 1440px) 70vw, 1000px' } = Astro.props;
const base = `/assets/illustration-cases/${name}`;
---
<picture>
  <img src={`${base}-800.webp`} srcset={`${base}-800.webp 800w, ${base}-1600.webp 1600w`} sizes={sizes} width={width} height={height} alt={alt} loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : 'auto'} decoding="async" />
</picture>
