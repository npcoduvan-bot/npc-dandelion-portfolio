---
interface Props {
  variant: 'noir' | 'pink' | 'levis' | 'nko' | 'signage' | 'green' | 'more' | 'dima' | 'maria';
  image?: string;
  srcSet?: string;
  alt?: string;
}

const { variant, image, srcSet, alt = '' } = Astro.props;
---

<div class={`project-visual cover-${variant}`}>
  {image && <img class="cover-photo" src={image} srcset={srcSet} sizes="(max-width: 560px) calc(100vw - 48px), (max-width: 1050px) 331px, 420px" alt={alt} loading="lazy" width={1374} height={1145} />}

  {variant === 'signage' && <div class="cover-signage-copy" aria-hidden="true">
    <span class="cover-kicker">07 / СРЕДОВОЙ ДИЗАЙН</span>
    <span class="cover-signage-track"></span>
    <span class="cover-signage-arrow">↗</span>
    <strong>ЗНАКИ<br /><span>И МЕСТА</span></strong>
    <span class="cover-signage-footer">НАВИГАЦИЯ · ПРОСТРАНСТВА</span>
  </div>}

  {variant === 'green' && !image && <div class="cover-green-copy" aria-hidden="true">
    <span class="cover-kicker">06 / DIGITAL И ПЕЧАТЬ</span>
    <span class="cover-green-leaf leaf-one"></span>
    <span class="cover-green-leaf leaf-two"></span>
    <span class="cover-green-leaf leaf-three"></span>
    <strong>ЗЕЛЁНЫЙ<br /><span>КУРС</span></strong>
    <span class="cover-green-footer">ГОРОД / ПРИРОДА / ИДЕИ</span>
  </div>}

  {variant === 'more' && <div class="cover-more-copy" aria-hidden="true">
    <span class="cover-kicker">08 / ПОДБОРКА РАБОТ</span>
    <span class="cover-more-sun"></span>
    <span class="cover-more-lines"></span>
    <strong>ЕЩЁ<span>↗</span></strong>
    <span class="cover-more-footer">ИДЕИ · ЛЮДИ · ПРОСТРАНСТВА</span>
  </div>}

  {!image && <span class="cover-pending">Материалы кейса готовятся к публикации</span>}
</div>
