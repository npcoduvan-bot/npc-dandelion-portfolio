    .view-work > * { transform: translateY(-3.5px); }
    .hero-manifest { left: var(--home-gutter); right: var(--home-gutter); top: 626px; width: auto; font-size: 10px; line-height: 16px; letter-spacing: 1.2px; text-align: left; }
    .hero-manifest > span, .hero-manifest .manifest-separator { display: inline; }
    .hero-manifest .manifest-separator { white-space: pre; }
    .hero-manifest::before, .hero-manifest::after { display: none; }
  }
  @media (min-width: 561px) and (max-width: 1050px) {
    .hero-leaves { left: 23%; top: -22px; width: 78.75%; max-width: none; height: 637.5px; }
    .hero-art { mask-image: linear-gradient(to bottom, #000 0%, #000 58%, #000b 76%, transparent 100%); }
    .hero-veins { top: 60px; height: 660px; }
    .view-work { max-width: 342px; }
  }
  @media (max-width: 389px) {
    h1 { font-size: calc((100cqw - 48px) * .24269); }
    h1 > span { height: calc((100cqw - 48px) * 83 / 342); line-height: calc((100cqw - 48px) * 83 / 342); }
    h1 > .title-works { height: calc((100cqw - 48px) * 86 / 342); line-height: calc((100cqw - 48px) * 86 / 342); }
    .dot-mobile { left: calc((100cqw - 48px) * .89766); top: calc((100cqw - 48px) * 67 / 342); }
    .directions { margin-top: calc(452px - (100cqw - 48px) * 169 / 342); }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('.home-hero .hero-stage');
  const accent = stage?.querySelector<SVGGElement>('.vein-color');
  const veins = stage?.querySelector<SVGElement>('.hero-veins');
  const leaves = stage?.querySelector<HTMLElement>('.hero-leaves');
  if (stage && accent && veins && leaves) {
    const paths = [...accent.querySelectorAll('path')];
    const allPaths = [...veins.querySelectorAll('path')];
    const desktopShapes = paths.map(path => path.getAttribute('d')!);
    const phoneShapes = [
      'M 1040,550 C 1100,460 1080,380 800,300 S 775,160 890,-30',
      'M 800,300 C 680,205 606,100 640,-20',
      desktopShapes[2]
    ];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const clamp = (n: number) => Math.max(0, Math.min(1, n));
    const ease = (n: number) => { const t = clamp(n); return t * t * (3 - 2 * t); };
    let stageTop = 0, travel = 1, fadeStart = 0, fadeDistance = 1;
    let current = window.scrollY, target = current, frame = 0, lastTime = 0;
    const paint = () => {
      const progress = ease((current - stageTop) / travel);
      const fade = (current - fadeStart) / fadeDistance;
      veins.style.opacity = String(reduced.matches ? 1 : 1 - ease(fade));
      leaves.style.opacity = String(reduced.matches ? 1 : 1 - ease(fade - .22));
      accent.style.opacity = String(reduced.matches ? 0 : ease(progress / .3));
      paths.forEach((path, i) => path.style.strokeDashoffset = String(9 - progress * (84 - i * 10)));
    };
    // Time-based damping gives wheel jumps and reverse scrolling the same
    // soft response at different refresh rates. Stop requesting frames at rest.
    const tick = (time: number) => {
      frame = 0;
      const dt = lastTime ? Math.min(time - lastTime, 64) : 16;
      lastTime = time;
      current += (target - current) * (1 - Math.exp(-dt / 150));
      if (Math.abs(target - current) < .1) current = target;
      paint();
      if (current !== target && !reduced.matches) frame = requestAnimationFrame(tick);
      else lastTime = 0;
    };
    const schedule = () => {
      target = window.scrollY;
      if (reduced.matches) { current = target; paint(); return; }
      if (!frame) frame = requestAnimationFrame(tick);
    };
    const measure = () => {
      const bounds = stage.getBoundingClientRect();
      const phone = window.matchMedia('(max-width: 560px)').matches;
      const tablet = window.matchMedia('(max-width: 1050px)').matches;
      allPaths.forEach((path, i) => {
        const index = i % 3;
        const shape = phone ? phoneShapes[index] : tablet && index === 0
          ? 'M 680,550 C 650,450 550,445 635,295 S 775,160 890,-30' : desktopShapes[index];
        path.setAttribute('d', shape);
        path.style.display = phone && index === 2 ? 'none' : '';
      });
      stageTop = bounds.top + window.scrollY;
      travel = Math.max(bounds.height * 1.4, window.innerHeight * .9);
      fadeStart = stageTop + bounds.height * .16;
      fadeDistance = window.innerHeight * .55;
      schedule();
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', measure, { passive: true });
    window.addEventListener('pageshow', measure);
    new ResizeObserver(measure).observe(stage);
    reduced.addEventListener('change', () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0; lastTime = 0; current = window.scrollY;
      measure();
    });
    measure();
  }
</script>
