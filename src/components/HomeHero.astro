<section class="home-hero" aria-labelledby="hero-title">
  <div class="hero-stage">
    <svg class="hero-orbits" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="hero-orbit-shadow" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#784256" stop-opacity=".85" />
          <stop offset=".55" stop-color="#784256" stop-opacity=".55" />
          <stop offset="1" stop-color="#784256" stop-opacity=".08" />
        </linearGradient>
      </defs>
      <circle class="hero-orbit-outer" fill="none" stroke="#784256" stroke-opacity=".44" />
      <circle class="hero-orbit-inner" fill="none" stroke="url(#hero-orbit-shadow)" />
      <circle class="hero-orbit-point" fill="#784256" />
    </svg>
    <div class="hero-leaves" aria-hidden="true">
      <svg viewBox="230 -20 1170 1110" focusable="false">
        <defs>
          <!-- Keep the approved leaf artwork; only refine its existing linework. -->
          <filter id="hero-fine-engraving" x="-2%" y="-2%" width="104%" height="104%" color-interpolation-filters="sRGB">
            <!-- Contrast/alpha gamma narrows fine line edges without erasing the veins. -->
            <feComponentTransfer in="SourceGraphic">
              <feFuncR type="gamma" amplitude="1" exponent="1.8" offset="0" />
              <feFuncG type="gamma" amplitude="1" exponent="1.8" offset="0" />
              <feFuncB type="gamma" amplitude="1" exponent="1.8" offset="0" />
              <feFuncA type="gamma" amplitude="1" exponent="1.5" offset="0" />
            </feComponentTransfer>
          </filter>
          <linearGradient id="hero-stem-shadow" gradientUnits="userSpaceOnUse" x1="0" y1="1024" x2="0" y2="565">
            <stop offset="0" stop-color="#000" />
            <stop offset=".85" stop-color="#fff" />
          </linearGradient>
          <mask id="hero-stem-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1536" height="1024">
            <rect width="1536" height="1024" fill="url(#hero-stem-shadow)" />
          </mask>
        </defs>
        <image href="/assets/hero/dandelion-leaves-plum.webp" x="0" y="0" width="1536" height="1024" transform="rotate(12 800 650)" filter="url(#hero-fine-engraving)" mask="url(#hero-stem-mask)" />
      </svg>
    </div>
    <div class="hero-content">
      <h1 id="hero-title" aria-label="THIS WORKS.">
        <span class="title-this">THIS</span>
        <span class="title-works">WORKS<img class="dot-desktop" src="/assets/figma/dot-desktop.svg" alt="" width="14" height="14" /><img class="dot-mobile" src="/assets/figma/dot-mobile.svg" alt="" width="8" height="8" /></span>
      </h1>
      <p class="directions"><span>Брендинг · Полиграфия</span><span class="directions-separator"> · </span><span>Иллюстрации · UX/UI</span></p>
      <a class="view-work" href="#projects"><span>СМОТРЕТЬ РАБОТЫ</span><img src="/assets/figma/arrow.svg" alt="" width="21.0938" height="12.6562" /></a>
    </div>
    <p class="hero-manifest"><span>ИДЕИ</span><span class="manifest-separator"> · </span><span>ЛЮДИ</span><span class="manifest-separator"> · </span><span>ПРОСТРАНСТВА</span></p>
  </div>
</section>

<style>
  .home-hero { container-type: inline-size; width: calc(100% + 2 * var(--home-gutter)); margin-inline: calc(-1 * var(--home-gutter)); background: #090909; }
  .hero-stage { position: relative; overflow: hidden; height: 38.96484375cqw; }
  .hero-stage::after { content: ''; position: absolute; bottom: 0; left: 5.078125%; right: 5.078125%; height: 1.125px; background: #2b2b2b; }
  .hero-orbits { position: absolute; inset: 0; width: 100%; height: 100%; overflow: hidden; pointer-events: none; }
  .hero-orbits circle { stroke-width: 1.25; }
  .hero-leaves { position: absolute; left: 41%; top: -3.5cqw; width: 53%; height: 46cqw; pointer-events: none; }
  .hero-leaves svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .hero-content { position: relative; z-index: 1; padding-top: 6.44097cqw; margin-left: 5.34722%; width: 49.51389%; }
  h1 { font-family: 'Bodoni Moda', Georgia, serif; font-weight: 400; font-synthesis: none; font-optical-sizing: none; font-size: 8.0078125cqw; line-height: 7.6171875cqw; color: #efedeb; margin: 0; }
  h1 > span { display: block; height: 7.77778cqw; white-space: nowrap; position: relative; }
  .title-this { letter-spacing: -.09765625cqw; }
  .title-works { letter-spacing: -.234375cqw; }
  .dot-desktop { position: absolute; left: 29.02778cqw; top: 5.76389cqw; max-width: none; }
  .dot-mobile { display: none; }
  .directions { margin: 3.95833cqw 0 0; padding-top: .97222cqw; position: relative; font-size: 1.31836cqw; line-height: 1.953125cqw; font-weight: 300; color: #b0afad; white-space: nowrap; }
  .directions::before { content: ''; position: absolute; top: 0; left: 0; width: 31.52778cqw; height: 1px; background: #b0afad; }
  .view-work { display: flex; align-items: center; justify-content: space-between; padding: 0 2.30469cqw; width: 17.28516cqw; height: 3.22266cqw; margin: 3.15104cqw 0 0 -.2691cqw; border: .984375px solid #cab4bb; border-radius: 25.3125px; font-size: .878906cqw; line-height: 1.171875cqw; letter-spacing: .05859cqw; color: #efedeb; transition: background .2s; }
  .view-work img { max-width: none; flex-shrink: 0; }
  .view-work > * { transform: translateY(-1.6875px); }
  .view-work:hover { background: #ffffff0d; }
  .hero-manifest { position: absolute; right: 5%; top: 27.899306cqw; margin: 0; width: 9.16667%; font-size: .878906cqw; line-height: 1.7578125cqw; text-align: right; letter-spacing: .078125cqw; color: #b0afad; }
  .hero-manifest > span { display: block; }
  .hero-manifest .manifest-separator { display: none; }
  .hero-manifest::before { content: ''; position: absolute; height: 8.984375cqw; width: .984375px; background: #efedeb; right: 0; bottom: calc(100% + 1.43403cqw); }
  .hero-manifest::after { content: ''; position: absolute; width: 2.5390625cqw; height: .984375px; background: #efedeb; right: 0; top: calc(100% + 1.46267cqw); }
  @media (max-width: 1050px) {
    .hero-stage { height: 670px; }
    .hero-leaves { left: 1%; top: 158px; width: 104%; height: 344px; }
    .hero-orbits circle { stroke-width: 1; }
    .hero-content { padding-top: 22px; margin-inline: var(--home-gutter); width: auto; }
    h1 { font-size: 83px; line-height: 83px; }
    h1 > span { height: 83px; letter-spacing: 0; }
    h1 > .title-works { height: 86px; line-height: 86px; }
    .dot-desktop { display: none; }
    .dot-mobile { display: block; position: absolute; left: 307px; top: 67px; max-width: none; }
    .directions { margin-top: 283px; padding: 0; font-size: 14px; line-height: 23px; white-space: normal; }
    .directions > span { display: block; }
    .directions .directions-separator, .directions::before { display: none; }
    .view-work { width: 100%; height: 50px; margin: 30px 0 0; justify-content: flex-start; gap: 30px; padding: 0 34px; font-size: 11px; line-height: 16px; letter-spacing: .84375px; }
    .view-work > * { transform: translateY(-3.5px); }
    .hero-manifest { left: var(--home-gutter); right: var(--home-gutter); top: 626px; width: auto; font-size: 10px; line-height: 16px; letter-spacing: 1.2px; text-align: left; }
    .hero-manifest > span, .hero-manifest .manifest-separator { display: inline; }
    .hero-manifest .manifest-separator { white-space: pre; }
    .hero-manifest::before, .hero-manifest::after, .hero-stage::after { display: none; }
  }
  @media (min-width: 561px) and (max-width: 1050px) {
    .hero-leaves { left: 37%; top: 18px; width: 61%; height: 512px; }
    .view-work { max-width: 342px; }
  }
  @media (max-width: 389px) {
    h1 { font-size: calc((100cqw - 48px) * .24269); }
    h1 > span { height: calc((100cqw - 48px) * 83 / 342); line-height: calc((100cqw - 48px) * 83 / 342); }
    h1 > .title-works { height: calc((100cqw - 48px) * 86 / 342); line-height: calc((100cqw - 48px) * 86 / 342); }
    .dot-mobile { left: calc((100cqw - 48px) * .89766); top: calc((100cqw - 48px) * 67 / 342); }
    .directions { margin-top: calc(452px - (100cqw - 48px) * 169 / 342); }
  }
</style>

<script>
  // Both orbits share a centre. The outer one passes through the existing title
  // period; no text or layout styles are involved in the animation.
  const stage = document.querySelector<HTMLElement>('.home-hero .hero-stage');
  const inner = stage?.querySelector<SVGCircleElement>('.hero-orbit-inner');
  const outer = stage?.querySelector<SVGCircleElement>('.hero-orbit-outer');
  const point = stage?.querySelector<SVGCircleElement>('.hero-orbit-point');

  if (stage && inner && outer && point) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let cx = 0, cy = 0, radius = 0, stageTop = 0, scrollDistance = 1;
    let frame = 0;

    const draw = () => {
      frame = 0;
      const progress = Math.max(0, Math.min(1, (window.scrollY - stageTop) / scrollDistance));
      const travel = reducedMotion.matches ? 0 : progress;
      const angle = (-157 - travel * 120) * Math.PI / 180;
      point.setAttribute('cx', String(cx + radius * Math.cos(angle)));
      point.setAttribute('cy', String(cy + radius * Math.sin(angle)));
      const shadow = Math.max(0, Math.min(1, (progress - .32) / .5));
      point.setAttribute('opacity', String(1 - shadow * shadow * (3 - 2 * shadow)));
    };

    const measure = () => {
      const bounds = stage.getBoundingClientRect();
      const mobile = window.matchMedia('(max-width: 1050px)').matches;
      const titlePoint = stage.querySelector<HTMLElement>(mobile ? '.dot-mobile' : '.dot-desktop');
      if (!titlePoint) return;
      const period = titlePoint.getBoundingClientRect();
      const px = period.left + period.width / 2 - bounds.left;
      const py = period.top + period.height / 2 - bounds.top;

      // Oversized circles are intentionally cropped by the original hero stage.
      // A shared centre guarantees that their contours can never cross.
      cx = bounds.width * (mobile ? .88 : .79);
      cy = mobile ? 350 : bounds.height * .48;
      const outerRadius = Math.hypot(px - cx, py - cy);
      radius = outerRadius * .80;
      for (const [circle, r] of [[outer, outerRadius], [inner, radius]] as const) {
        circle.setAttribute('cx', String(cx));
        circle.setAttribute('cy', String(cy));
        circle.setAttribute('r', String(r));
      }
      point.setAttribute('r', mobile ? '4' : String(Math.max(4, bounds.width * .0052)));
      stageTop = bounds.top + window.scrollY;
      scrollDistance = bounds.height * .8;
      draw();
    };

    const onScroll = () => { if (!frame) frame = requestAnimationFrame(draw); };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', measure, { passive: true });
    reducedMotion.addEventListener('change', draw);
    new ResizeObserver(measure).observe(stage);
    document.fonts.ready.then(measure);
    measure();
  }
</script>
