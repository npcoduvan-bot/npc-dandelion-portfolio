---
import '../styles/global.css';
import '../styles/project-covers.css';
import SiteHeader from '../components/SiteHeader.astro';
import HomeHero from '../components/HomeHero.astro';
import ProjectCover from '../components/ProjectCover.astro';

const cases = [
  { number: '01', title: 'NOIR COFFEE', kind: 'Брендинг · визуальная система', className: 'noir', image: '/assets/covers/noir-coffee-v2-700.webp', srcSet: '/assets/covers/noir-coffee-v2-700.webp 700w, /assets/covers/noir-coffee-v2-1400.webp 1374w', alt: 'Чёрный фирменный фартук NOIR COFFEE, визитки и эспрессо на камне — ИИ-мокап по исходной айдентике', href: '/projects/noir-coffee/' },
  { number: '02', title: 'Мария Зорина / ZMS', kind: 'Веб-дизайн · сайт фотографа', className: 'maria', image: '/assets/maria/creative.webp', alt: 'Свет на воде — авторская фотография Марии Зориной', href: '/projects/maria-zorina/' },
  { number: '03', title: 'НЕ НА ЗАКАЗ', kind: 'Веб-дизайн · фотопортфолио', className: 'dima', image: '/assets/dima/dima-approved-cover.jpg', alt: 'Утверждённая обложка НЕ НА ЗАКАЗ: море, яхта, оранжевая квадратная рамка с котом и надпись «Этот тоже не заказывал»', href: '/projects/dima-ne-na-zakaz/' },
  { number: '04', title: 'Levi’s Sochi', kind: 'Реклама · соцсети · графика', className: 'levis', image: '/assets/covers/levis-sochi-v2-700.webp', srcSet: '/assets/covers/levis-sochi-v2-700.webp 700w, /assets/covers/levis-sochi-v2-1400.webp 1374w', alt: 'Три рекламных макета Levi’s и сложенный деним на светлом камне — ИИ-мокап по материалам кейса', href: '/projects/levis-sochi/' },
  { number: '05', title: 'Причина счастья', kind: 'НКО · айдентика · иллюстрация', className: 'nko', image: '/assets/covers/prichina-schastya-v2-700.webp', srcSet: '/assets/covers/prichina-schastya-v2-700.webp 700w, /assets/covers/prichina-schastya-v2-1400.webp 1374w', alt: 'Иллюстративные карточки «Счастье», «Вдохновение» и «Дружба» с бирюзовой коробкой — ИИ-мокап по материалам «Причины счастья»', href: '/projects/prichina-schastya/' },
  { number: '06', title: 'Розовая кофейня', kind: 'Интерьер · графика · печать', className: 'pink', image: '/assets/covers/pink-cafe-v3-700.webp', srcSet: '/assets/covers/pink-cafe-v3-700.webp 700w, /assets/covers/pink-cafe-v3-1400.webp 1374w', alt: 'Два флаера «Вкус кофе» одного размера, лицевая сторона со скидкой 10% и оборотная с фламинго — мокап с розовым камнем, кофе и тенью листьев', href: '/projects/pink-cafe/' },
  { number: '07', title: 'Другие проекты', kind: 'Подборка работ', className: 'more' }
];

const illustrations = [
  { image: '/assets/illustration-deer.png', alt: 'Авторская иллюстрация: олень в горящем лесу', title: 'Олень в горящем лесу' },
  { image: '/assets/illustration-angel.png', alt: 'Авторская иллюстрация: ангел в белом платье', title: 'Ангел' },
  { image: '/assets/illustration-city.jpg', alt: 'Авторская иллюстрация: девушка с телефоном на фоне города', title: 'Город' }
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090909" />
    <meta name="description" content="NPC Dandelion — графический дизайн, айдентика, полиграфия, иллюстрация и оформление пространств." />
    <link rel="preload" href="/fonts/portfolio/Bodoni-Moda-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <title>NPC Dandelion — графический дизайнер</title>
  </head>
  <body class="home-page">
    <a class="skip-link" href="#main">К содержимому</a>
    <div class="site-shell">
      <SiteHeader home />

      <main id="main">
        <HomeHero />

        <section class="section projects" id="projects" aria-labelledby="projects-title">
          <div class="section-heading"><h2 id="projects-title">ВЫБРАННЫЕ РАБОТЫ</h2><span>Графический дизайн / 2026</span></div>
          <div class="project-grid">
            {cases.map((item) => (
              <article class={`project-card ${item.className}`}>
                <ProjectCover variant={item.className} image={item.image} srcSet={item.srcSet} alt={item.alt} />
                <div class="project-info"><div><h3>{item.href ? <a class="project-case-link" href={item.href}>{item.title}<span class="case-link-arrow" aria-hidden="true"> ↗</span></a> : item.title}</h3><p>{item.kind}</p></div><span class="project-number">{item.number}</span></div>
              </article>
            ))}
          </div>
          <p class="project-footnote">Открыты кейсы NOIR COFFEE, «Розовая кофейня», «НЕ НА ЗАКАЗ», Levi’s Sochi, «Причина счастья» и сайта Марии Зориной. Остальные работы готовятся к публикации.</p>
        </section>

        <section class="section illustrations" id="illustrations" aria-labelledby="illustrations-title">
          <div class="section-heading"><h2 id="illustrations-title">ИЛЛЮСТРАЦИИ</h2><span>Авторские работы</span></div>
          <div class="illustration-grid">
            {illustrations.map((item) => <figure><img src={item.image} alt={item.alt} loading="lazy" /><figcaption>{item.title}</figcaption></figure>)}
          </div>
        </section>

        <section class="section about-contact" id="about" aria-labelledby="about-title">
          <div class="about-block"><h2 id="about-title">ОБО МНЕ</h2><p>Я создаю визуальные решения, которые помогают брендам, проектам и людям говорить о важном. В моих работах сочетаются эстетика, смысл и внимание к деталям.</p><a class="text-link" href="https://www.behance.net/npcoduvan" target="_blank" rel="noopener noreferrer">Больше работ на Behance <span aria-hidden="true">→</span></a></div>
          <blockquote>«Дизайн — это способ<br />делать мир немного яснее»</blockquote>
          <div class="contact-block" id="contacts"><h2>КОНТАКТЫ</h2><a class="contact-link" href="https://t.me/npc_dandelion" target="_blank" rel="noopener noreferrer" aria-label="Написать @npc_dandelion в Telegram">Telegram <span aria-hidden="true">↗</span></a><p>@npc_dandelion</p><p>Буду рада новым проектам!</p></div>
        </section>
      </main>
      <footer class="site-footer"><span>© 2026 NPC Dandelion</span><a href="#top" aria-label="Наверх">↑</a><span>Идеи · Люди · Пространства</span></footer>
    </div>
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });
        document.querySelectorAll('.project-card, .illustration-grid figure').forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>
