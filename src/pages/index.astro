---
import '../styles/global.css';

const cases = [
  { number: '01', title: 'NOIR COFFEE', kind: 'Брендинг · визуальная система', className: 'noir', image: '/assets/noir/mockup-900.webp', alt: 'Визитки NOIR COFFEE: белый логотип на чёрном фоне и мраморная графика', href: '/projects/noir-coffee/' },
  { number: '02', title: 'Розовая кофейня', kind: 'Интерьер · графика · печать', className: 'pink' },
  { number: '03', title: 'НКО', kind: 'Айдентика · полиграфия · событие', className: 'nko' },
  { number: '04', title: 'Вывески и пространства', kind: 'Средовой дизайн · навигация', className: 'signage' },
  { number: '05', title: 'Зелёный курс города', kind: 'Digital · печать', className: 'green' },
  { number: '06', title: 'Другие проекты', kind: 'Подборка работ', className: 'more' }
];

const illustrations = [
  { image: '/assets/illustration-deer.png', alt: 'Авторская иллюстрация: олень в горящем лесу', title: 'Олень в горящем лесу' },
  { image: '/assets/illustration-angel.png', alt: 'Авторская иллюстрация: ангел в белом платье', title: 'Ангел' },
  { image: '/assets/illustration-city.jpg', alt: 'Авторская иллюстрация: девушка с телефоном на фоне города', title: 'Город' }
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="description" content="NPC Dandelion — графический дизайн, айдентика, полиграфия, иллюстрация и оформление пространств." />
    <title>NPC Dandelion — графический дизайнер</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">К содержимому</a>
    <div class="site-shell">
      <header class="site-header" id="top">
        <a class="brand" href="#top" aria-label="NPC Dandelion — наверх">
          <img src="/assets/dandelion-leaf.png" alt="" width="40" height="42" />
          <span class="brand-rule"></span>
          <span class="brand-label">ГРАФИЧЕСКИЙ<br />ДИЗАЙНЕР</span>
        </a>
        <nav class="desktop-nav" aria-label="Основная навигация">
          <a href="#projects">ПРОЕКТЫ</a>
          <a href="#about">ОБО МНЕ</a>
          <a href="#contacts">КОНТАКТЫ</a>
        </nav>
        <a class="contact-pill" href="https://t.me/npc_dandelion" aria-label="Связаться в Telegram: @npc_dandelion" target="_blank" rel="noopener noreferrer">СВЯЗАТЬСЯ <span aria-hidden="true">→</span></a>
      </header>

      <nav class="mobile-nav" aria-label="Разделы страницы">
        <a href="#projects">ПРОЕКТЫ</a><a href="#about">ОБО МНЕ</a><a href="#contacts">КОНТАКТЫ</a>
      </nav>

      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-art" aria-hidden="true"></div>
          <div class="hero-side hero-side-left"><span>ИДЕИ<br />ЛЮДИ<br />ПРОСТРАНСТВА<br />В БОЛЬШЕЕ,<br />ЧЕМ ДИЗАЙН</span><i></i></div>
          <div class="hero-copy">
            <h1 id="hero-title">THIS<br />WORKS<span class="accent-dot">.</span></h1>
            <p class="hero-lede">Дизайн, который соединяет<br />эстетику и смысл</p>
          </div>
          <div class="hero-side hero-side-right"><span>01</span><i></i><span>БОЛЬШЕ<br />ЧЕМ<br />ДИЗАЙН</span></div>
          <div class="hero-bottom">
            <p>Брендинг · Полиграфия · Иллюстрации · Социальные проекты</p>
            <a class="outline-button" href="#projects">СМОТРЕТЬ РАБОТЫ <span aria-hidden="true">→</span></a>
          </div>
        </section>

        <section class="section projects" id="projects" aria-labelledby="projects-title">
          <div class="section-heading"><h2 id="projects-title">ВЫБРАННЫЕ РАБОТЫ</h2><span>Графический дизайн / 2026</span></div>
          <div class="project-grid">
            {cases.map((item) => (
              <article class={`project-card ${item.className}`}>
                <div class="project-visual">
                  {item.image ? <img src={item.image} alt={item.alt} loading="lazy" width="900" height="600" /> : <span class="asset-note">Материалы кейса готовятся к публикации</span>}
                  {!item.image && <span class="project-watermark" aria-hidden="true">{item.number}</span>}
                </div>
                <div class="project-info"><div><h3>{item.href ? <a class="project-case-link" href={item.href}>{item.title}<span class="case-link-arrow" aria-hidden="true"> ↗</span></a> : item.title}</h3><p>{item.kind}</p></div><span class="project-number">{item.number}</span></div>
              </article>
            ))}
          </div>
          <p class="project-footnote">NOIR COFFEE — полный кейс: от логотипа до носителей. Остальные проекты готовятся к публикации.</p>
        </section>

        <section class="section illustrations" id="illustrations" aria-labelledby="illustrations-title">
          <div class="section-heading"><h2 id="illustrations-title">ИЛЛЮСТРАЦИИ</h2><span>Авторские работы</span></div>
          <div class="illustration-grid">
            {illustrations.map((item) => <figure><img src={item.image} alt={item.alt} loading="lazy" /><figcaption>{item.title}</figcaption></figure>)}
          </div>
        </section>

        <section class="section about-contact" id="about" aria-labelledby="about-title">
          <div class="about-block"><h2 id="about-title">ОБО МНЕ</h2><p>Я создаю визуальные решения, которые помогают брендам, проектам и людям говорить о важном. В моих работах сочетаются эстетика, смысл и внимание к деталям.</p><a class="text-link" href="https://www.behance.net/npcoduvan" target="_blank" rel="noopener noreferrer">Больше работ на Behance <span aria-hidden="true">→</span></a></div>
          <blockquote>«Дизайн — это способ<br />делать мир немного яснее»</blockquote>
          <div class="contact-block" id="contacts"><h2>КОНТАКТЫ</h2><a class="contact-link" href="https://t.me/npc_dandelion" target="_blank" rel="noopener noreferrer" aria-label="Написать @npc_dandelion в Telegram">Telegram <span aria-hidden="true">↗</span></a><p>@npc_dandelion</p><p>Буду рада новым проектам!</p></div>
        </section>
      </main>
      <footer class="site-footer"><span>© 2026 NPC Dandelion</span><a href="#top" aria-label="Наверх">↑</a><span>Идеи · Люди · Пространства</span></footer>
    </div>
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });
        document.querySelectorAll('.project-card, .illustration-grid figure').forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>
